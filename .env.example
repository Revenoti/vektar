# SERVER ONLY. Never prefix Retell configuration with VITE_.
# Copy to a PRIVATE, untracked .env. Node does not load it automatically.
# Local: node --env-file=.env server/index.js (Node 22+)
# Production: inject with your hosting provider's secret manager.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# Enable only after configuring the agent, consent/retention policy,
# approved outbound number, permitted destination regions and provider budget.
ENABLE_WEB_CALLS=false
ENABLE_CALLBACKS=false
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001
CALLBACK_ALLOWED_PREFIXES=+1

# One Node process / replica with a PERSISTENT private volume.
# Salted hashes and call outcomes only; no names/numbers/session tokens.
# Never share this file across replicas. Use a transactional store to scale.
CALL_STATE_PATH=.data/call-state.json
CALL_DAILY_LIMIT=30
CALL_IP_LIMIT=4
CALL_PROVIDER_TIMEOUT_MS=10000
PORT=3001
# Default: ignore forwarding headers. Set only verified ingress/proxy IPs.
# Exact IP allowlist (no CIDRs/wildcards); comma-separated, empty by default.
# Configure the ingress to append/replace X-Forwarded-For correctly.
CALL_TRUSTED_PROXY_IPS=
# Untrusted peers or malformed chains use the socket IP for rate limits.
# Add edge rate limits / bot protection before enabling public calling.
