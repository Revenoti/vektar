  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx", "allowJs": true,
    "checkJs": false, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
